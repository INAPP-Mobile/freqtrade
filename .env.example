# Freqtrade on Railway — environment overrides
# Any config value can be overridden with the FREQTRADE__ prefix (double
# underscore = nesting), e.g. FREQTRADE__EXCHANGE__NAME=kraken
# Reference: https://www.freqtrade.io/en/stable/configuration/#environment-variables

# ==============================================================================
# API SERVER / FREQUI (Railway injects PORT=8080; matches the domain target)
# ==============================================================================

PORT=8080

# Enable the REST API + FreqUI (required for the web interface)
FREQTRADE__API_SERVER__ENABLED=true

# REST API + FreqUI credentials (REQUIRED — change from defaults!)
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=change-me-please
FREQTRADE__API_SERVER__JWT_SECRET_KEY=change-me-to-a-long-random-string
FREQTRADE__API_SERVER__WS_TOKEN=change-me-ws-token

# ==============================================================================
# BOT BEHAVIOR
# ==============================================================================

# Paper-trading mode (keep true until you have validated your strategy!)
FREQTRADE__DRY_RUN=true
# Paper wallet balance
FREQTRADE__DRY_RUN_WALLET=1000

# Strategy class name to run (file must exist in user_data/strategies/)
FREQTRADE__STRATEGY=SampleStrategy

# ==============================================================================
# EXCHANGE
# ==============================================================================

# Exchange name (binance, kraken, kucoin, gate, okx, ...) — see freqtrade docs
FREQTRADE__EXCHANGE__NAME=kraken

# Live-trading API keys (leave empty for dry-run)
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Pairs to trade (static pairlist default)
# FREQTRADE__EXCHANGE__PAIR_WHITELIST=["BTC/USD","ETH/USD"]

# ==============================================================================
# TELEGRAM CONTROL (optional)
# ==============================================================================

FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=